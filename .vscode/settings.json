{
  // Point VS Code at the project's pinned interpreter (clifpy 0.4.9, Python
  // 3.11.15) rather than whatever Python is on PATH. This is what makes
  // autocomplete, type hints, and the Run button use the right packages.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // Run and debug from the repo root, not from code/. Scripts here find their
  // own paths via Path(__file__), so this is belt-and-braces, but it keeps
  // relative paths in the terminal predictable.
  "python.terminal.executeInFileDir": false,

  // Auto-activate the venv in new integrated terminals.
  "python.terminal.activateEnvironment": true,

  "[python]": {
    "editor.rulers": [100],
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },

  // The tutorial and planning docs are prose; soft-wrap them.
  "[markdown]": {
    "editor.wordWrap": "on"
  },

  // Never index or search the data tree or the virtualenv.
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/renv/library": true,
    "**/output": true
  }
}
